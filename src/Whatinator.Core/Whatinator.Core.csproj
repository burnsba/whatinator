<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Whatinator.LibDiscId\Whatinator.LibDiscId.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CRC32 for phase 014's cd-paranoia track runner (Test/Copy CRC) -
         added here alongside this phase's AccurateRip primitives since both
         live under Whatinator.Core.AccurateRip. No source file in this
         phase uses it directly; System.IO.Hashing.Crc32 is referenced
         straight from callers. -->
