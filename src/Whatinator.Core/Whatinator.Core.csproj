  </ItemGroup>

  <ItemGroup>
    <!-- Lets Whatinator.Core.Tests exercise internal members directly (e.g.
         FlacEncoder.BuildStartInfo) without spawning real subprocesses. -->
    <InternalsVisibleTo Include="Whatinator.Core.Tests" />
  </ItemGroup>

</Project>
