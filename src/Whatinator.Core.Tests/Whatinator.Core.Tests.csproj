<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Whatinator.Core\Whatinator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real AccurateRip database responses, captured live against real
         discs - see AccurateRipClientTests and AccurateRipChecksumTests. -->
    <None Include="AccurateRip\Fixtures\*.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- A real 15-second clip from the start of a real disc's track 1,
         lossless-compressed - see
         AccurateRipChecksumTests.Compute_RealTrack1Clip_MatchesIndependentlyVerifiedChecksum. -->
    <None Include="AccurateRip\Fixtures\*.flac">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>